# Copy to .env and fill in. Never commit .env.
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.ai/v1
STEPFUN_MODEL=step-5-preview
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
PHOTON_API_KEY=
FETCHAI_API_KEY=
SENTRY_DSN=
TIGER_DATA_URL=
# Strap receiver (machine-specific; defaults live in backend/config.py)
RECEIVER_WEARABLE_ID=1
RECEIVER_INGEST_URL=ws://localhost:8000/ws/ingest
RECEIVER_STRAP_NAME_PREFIX=Polar H10
# Fetch.ai agent (agent/; FETCHAI_API_KEY above is the ASI:One key)
AGENT_BACKEND_URL=http://localhost:8000
AGENT_SEED=
AGENTVERSE_KEY=
USE_AGENTS=
ASI_BASE_URL=https://api.asi1.ai/v1
ASI_MODEL=asi1
