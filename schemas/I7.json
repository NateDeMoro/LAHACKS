{
  "$defs": {
    "BaselineConfig": {
      "additionalProperties": false,
      "description": "Personal baseline settings (T3). Times are minutes of wall-clock, not row counts.\nUnlike other models these have real defaults (the shipped config.json values) so a missing\nfield can never crash the engine.",
      "properties": {
        "min_minutes": {
          "default": 10,
          "title": "Min Minutes",
          "type": "number"
        },
        "arrival_check_minutes": {
          "default": 3,
          "title": "Arrival Check Minutes",
          "type": "number"
        },
        "learn_minutes": {
          "default": 30,
          "title": "Learn Minutes",
          "type": "number"
        },
        "min_clean_seconds": {
          "default": 40,
          "title": "Min Clean Seconds",
          "type": "integer"
        },
        "n0_min": {
          "default": 0.5,
          "title": "N0 Min",
          "type": "number"
        },
        "n0_max": {
          "default": 5,
          "title": "N0 Max",
          "type": "number"
        },
        "k": {
          "default": 2.5,
          "title": "K",
          "type": "number"
        },
        "spread_floor": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {
            "hr": 5,
            "resp_rate": 1
          },
          "title": "Spread Floor",
          "type": "object"
        },
        "min_width": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {
            "hr": 16,
            "resp_rate": 6
          },
          "title": "Min Width",
          "type": "object"
        }
      },
      "title": "BaselineConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaselineConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "persistence_windows": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Persistence Windows"
    },
    "probability_cutoffs": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Probability Cutoffs"
    }
  },
  "title": "ModelConfig",
  "type": "object"
}
