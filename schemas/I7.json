{
  "$defs": {
    "AlertConfig": {
      "additionalProperties": false,
      "description": "Alert logic settings (T4), minutes. Real defaults like BaselineConfig; T4 tunes the windows.",
      "properties": {
        "warning_persisted_minutes": {
          "default": 5,
          "title": "Warning Persisted Minutes",
          "type": "number"
        },
        "vital_danger_minutes": {
          "default": 2,
          "title": "Vital Danger Minutes",
          "type": "number"
        },
        "news2_total_minutes": {
          "default": 2,
          "title": "News2 Total Minutes",
          "type": "number"
        },
        "trend_minutes": {
          "default": 5,
          "title": "Trend Minutes",
          "type": "number"
        },
        "max_gap_minutes": {
          "default": 10,
          "title": "Max Gap Minutes",
          "type": "number"
        },
        "clear_minutes": {
          "default": 5,
          "title": "Clear Minutes",
          "type": "number"
        },
        "ack_cooldown_minutes": {
          "default": 15,
          "title": "Ack Cooldown Minutes",
          "type": "number"
        }
      },
      "title": "AlertConfig",
      "type": "object"
    },
    "BaselineConfig": {
      "additionalProperties": false,
      "description": "Personal baseline settings (T3). Times are minutes of wall-clock, not row counts.\nUnlike other models these have real defaults (the shipped config.json values) so a missing\nfield can never crash the engine.",
      "properties": {
        "min_minutes": {
          "default": 10,
          "title": "Min Minutes",
          "type": "number"
        },
        "arrival_check_minutes": {
          "default": 3,
          "title": "Arrival Check Minutes",
          "type": "number"
        },
        "learn_minutes": {
          "default": 30,
          "title": "Learn Minutes",
          "type": "number"
        },
        "min_clean_seconds": {
          "default": 40,
          "title": "Min Clean Seconds",
          "type": "integer"
        },
        "n0_min": {
          "default": 0.5,
          "title": "N0 Min",
          "type": "number"
        },
        "n0_max": {
          "default": 5,
          "title": "N0 Max",
          "type": "number"
        },
        "k": {
          "default": 2.5,
          "title": "K",
          "type": "number"
        },
        "spread_floor": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {
            "hr": 5,
            "resp_rate": 1
          },
          "title": "Spread Floor",
          "type": "object"
        },
        "min_width": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {
            "hr": 16,
            "resp_rate": 6
          },
          "title": "Min Width",
          "type": "object"
        }
      },
      "title": "BaselineConfig",
      "type": "object"
    },
    "TrendConfig": {
      "additionalProperties": false,
      "description": "Fast trend settings (T6). The cutoff is set from MIMIC at training time.",
      "properties": {
        "fast_min_clean_minutes": {
          "default": 15,
          "title": "Fast Min Clean Minutes",
          "type": "number"
        },
        "fast_warning_cutoff": {
          "default": 0.5,
          "title": "Fast Warning Cutoff",
          "type": "number"
        }
      },
      "title": "TrendConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaselineConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "alerts": {
      "anyOf": [
        {
          "$ref": "#/$defs/AlertConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trend": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrendConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "ModelConfig",
  "type": "object"
}
